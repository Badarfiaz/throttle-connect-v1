rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    // Existing ilmrasta path - public read/write
    match /ilmrasta/{userId}/{allPaths=**} {
      allow read, write: if true;
    }

    // Marketplace stores can read/write their own folders
    match /marketplaceStores/{storeId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == storeId;
    }

    // Members can read/write their own folders
    match /members/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Deny all other paths by default
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
